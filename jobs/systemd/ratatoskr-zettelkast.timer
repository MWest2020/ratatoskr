# SPDX-License-Identifier: MIT
[Unit]
Description=Dagelijkse zettelkast-terugkoppeling (wat is verwerkt, wat blijft liggen)

[Timer]
# Ná de capture-run van de zettelkast (zettelkast-daily.timer, 06:00). Ruim
# ertussen: die run kan een achterstand van tientallen bronnen inhalen.
OnCalendar=*-*-* 09:00
# Persistent: een gemiste run haalt bij boot in en toont dán de actuele stand —
# nog steeds bruikbaar, anders dan de datum-relatieve 'gedaan'-terugblik.
Persistent=true
Unit=ratatoskr-job@zettelkast_dagelijks.service

[Install]
WantedBy=timers.target
