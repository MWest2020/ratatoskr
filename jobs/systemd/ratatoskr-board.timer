# SPDX-License-Identifier: EUPL-1.2
[Unit]
Description=Ververs het werk-overzicht elke 2 minuten

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
# Niet Persistent: een gemiste run haalt niets in wat de volgende niet ook doet —
# dit is een momentopname, geen gebeurtenis.
Persistent=false

[Install]
WantedBy=timers.target
