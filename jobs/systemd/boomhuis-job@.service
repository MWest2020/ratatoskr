[Unit]
Description=Boomhuis recurring job %i

[Service]
Type=oneshot
Environment=PATH=/home/agent/.local/bin:/home/agent/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=SOPS_AGE_KEY_FILE=/home/agent/.config/sops/age/keys.txt
Environment=BUZZ_RELAY_URL=ws://192.168.178.60:3000
Environment=BUZZ_BIN=/home/agent/.local/bin/buzz
Environment=CLAUDE_BIN=/home/agent/.npm-global/bin/claude
WorkingDirectory=/home/agent/boomhuis
ExecStart=/usr/bin/bash /home/agent/boomhuis/jobs/run-jobs.sh %i
