# SPDX-License-Identifier: MIT
[Unit]
Description=Prune the relay's media store daily at 04:30

[Timer]
OnCalendar=*-*-* 04:30:00
# Persistent: a missed day still runs at the next boot; images must not live
# longer than 30 days because the host was down.
Persistent=true

[Install]
WantedBy=timers.target
