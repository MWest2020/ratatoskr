# SPDX-License-Identifier: EUPL-1.2
"""VM-zijdige helper voor push_subs.json — draait als root via één vastgepinde
sudoers-regel, zodat de sender op agent-lxc NIET `sudo sh`/`sudo python3 -c`
(feitelijk een root-shell) nodig heeft. Least privilege: sudoers pint precies dit
pad, dit script accepteert alleen `read` en `prune`.

  sudo -n /usr/local/bin/boomhuis-push-subs read           # print de subs (of [])
  echo '["<endpoint>", ...]' | sudo -n .../boomhuis-push-subs prune   # verwijder

Deploy: uit deze repo `orchestrator/vm/boomhuis-push-subs` →
`/usr/local/bin/boomhuis-push-subs` (root:root 0755). Zie chat/README.md → Web Push.
"""
import json
import os
import sys

# Since the compose migration (2026-09-11) the chat runs in a container and its
# state lives in a named volume, not in /var/lib/boomhuis. That broke push
# silently: the sender kept reading the old path, found an empty file and
# reported "no subscriptions" while the phone was subscribed. Measured
# 2026-09-12 — Mark: "ook geen meldingen".
#
# Both paths, new first. The old one stays until the cleanup change removes it,
# so a rollback to the systemd unit still notifies.
PATHS = [
    "/var/lib/docker/volumes/buzz-prod_ratatoskr-chat-data/_data/push_subs.json",
    "/var/lib/boomhuis/push_subs.json",
]


def _path():
    """The first path that holds actual subscriptions, else the newest one.
    An empty file must not win over a filled one: that is exactly how this
    broke."""
    for p in PATHS:
        try:
            with open(p) as f:
                if json.load(f):
                    return p
        except (OSError, ValueError):
            continue
    return PATHS[0]


def _read():
    # Ontbrekend bestand = nog geen abonnees (legitiem 0 subs). Elke ANDERE fout
    # (rechten, I/O) propageert als exception → rc!=0, zodat de sender geen vals
    # "0 subs" meldt.
    if not os.path.exists(_path()):
        return []
    with open(_path()) as f:
        d = json.load(f)
    return d if isinstance(d, list) else []


def _write(subs):
    doel = _path()
    os.makedirs(os.path.dirname(doel), exist_ok=True)
    tmp = doel + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(subs, f)
    os.replace(tmp, doel)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "read":
        json.dump(_read(), sys.stdout)
    elif cmd == "prune":
        dead = set(json.load(sys.stdin))
        keep = [s for s in _read() if s.get("endpoint") not in dead]
        _write(keep)
        print(f"pruned {len(dead)}", file=sys.stderr)
    else:
        sys.exit("gebruik: boomhuis-push-subs read|prune")


if __name__ == "__main__":
    main()
