#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""VM-side helper for push_subs.json — runs as root through one pinned sudoers
rule, so the sender on agent-lxc does NOT need `sudo sh`/`sudo python3 -c` (a
root shell in all but name). Least privilege: sudoers pins exactly this path and
this script accepts only `read` and `prune`.

  sudo -n /usr/local/bin/boomhuis-push-subs read           # print the subs (or [])
  echo '["<endpoint>", ...]' | sudo -n .../boomhuis-push-subs prune   # remove

Deploy: from this repo `orchestrator/vm/boomhuis-push-subs` →
`/usr/local/bin/boomhuis-push-subs` (root:root 0755). See chat/README.md → Web Push.
"""
import json
import os
import sys

# Since the compose migration (2026-09-11) the chat runs in a container and its
# state lives in a named volume, not in /var/lib/boomhuis. That broke push
# silently: the sender kept reading the old path, found an empty file and
# reported "no subscriptions" while the phone was subscribed. Measured
# 2026-09-12 — Mark: "ook geen meldingen".
#
# Both paths, new first. The old one stays until the cleanup change removes it,
# so a rollback to the systemd unit still notifies.
PATHS = [
    "/var/lib/docker/volumes/buzz-prod_ratatoskr-chat-data/_data/push_subs.json",
    "/var/lib/boomhuis/push_subs.json",
]


def _path():
    """The first path that holds actual subscriptions, else the newest one.
    An empty file must not win over a filled one: that is exactly how this
    broke."""
    for p in PATHS:
        try:
            with open(p) as f:
                if json.load(f):
                    return p
        except (OSError, ValueError):
            continue
    return PATHS[0]


def _read():
    # A missing file means nobody has subscribed yet (a legitimate 0 subs). Every
    # OTHER error (permissions, I/O) propagates as an exception → rc != 0, so the
    # sender never reports a false "0 subs".
    if not os.path.exists(_path()):
        return []
    with open(_path()) as f:
        d = json.load(f)
    return d if isinstance(d, list) else []


def _owner(target):
    """Who must own the file after we replace it, and with which mode.

    This script runs as root, but the file belongs to the chat — which runs as
    an unprivileged user in a container. Writing a fresh root:root 0600 file
    therefore does not merely change the owner: it takes the file away from its
    only writer. Measured on 2026-09-13, and it is exactly how push died
    silently: a prune left `[]` as root:root 0600, after which the chat could
    not read it, could not store a new subscription, and reported nothing.

    So: keep what the file already had, and if it is gone, follow the directory
    it lives in — that directory is the volume, and the volume belongs to the
    chat.
    """
    try:
        st = os.stat(target)
    except OSError:
        st = os.stat(os.path.dirname(target))
        return st.st_uid, st.st_gid, 0o600
    return st.st_uid, st.st_gid, st.st_mode & 0o777


def _write(subs):
    target = _path()
    os.makedirs(os.path.dirname(target), exist_ok=True)
    uid, gid, mode = _owner(target)
    tmp = target + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(subs, f)
    os.chown(tmp, uid, gid)
    os.chmod(tmp, mode)
    os.replace(tmp, target)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "read":
        json.dump(_read(), sys.stdout)
    elif cmd == "prune":
        dead = set(json.load(sys.stdin))
        keep = [s for s in _read() if s.get("endpoint") not in dead]
        _write(keep)
        print(f"pruned {len(dead)}", file=sys.stderr)
    else:
        sys.exit("usage: boomhuis-push-subs read|prune")


if __name__ == "__main__":
    main()
