"""VM-zijdige helper voor push_subs.json — draait als root via één vastgepinde
sudoers-regel, zodat de sender op agent-lxc NIET `sudo sh`/`sudo python3 -c`
(feitelijk een root-shell) nodig heeft. Least privilege: sudoers pint precies dit
pad, dit script accepteert alleen `read` en `prune`.

  sudo -n /usr/local/bin/boomhuis-push-subs read           # print de subs (of [])
  echo '["<endpoint>", ...]' | sudo -n .../boomhuis-push-subs prune   # verwijder

Deploy: uit deze repo `orchestrator/vm/boomhuis-push-subs` →
`/usr/local/bin/boomhuis-push-subs` (root:root 0755). Zie chat/README.md → Web Push.
"""
import json
import os
import sys

PATH = "/var/lib/boomhuis/push_subs.json"


def _read():
    # Ontbrekend bestand = nog geen abonnees (legitiem 0 subs). Elke ANDERE fout
    # (rechten, I/O) propageert als exception → rc!=0, zodat de sender geen vals
    # "0 subs" meldt.
    if not os.path.exists(PATH):
        return []
    with open(PATH) as f:
        d = json.load(f)
    return d if isinstance(d, list) else []


def _write(subs):
    os.makedirs(os.path.dirname(PATH), exist_ok=True)
    tmp = PATH + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(subs, f)
    os.replace(tmp, PATH)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "read":
        json.dump(_read(), sys.stdout)
    elif cmd == "prune":
        dead = set(json.load(sys.stdin))
        keep = [s for s in _read() if s.get("endpoint") not in dead]
        _write(keep)
        print(f"pruned {len(dead)}", file=sys.stderr)
    else:
        sys.exit("gebruik: boomhuis-push-subs read|prune")


if __name__ == "__main__":
    main()
