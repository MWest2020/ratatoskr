# Ratatoskr — installatie-instellingen. Kopieer naar `.env` (mode 0600) en vul in.
# Niets hier is geheim zolang het een placeholder is; het ingevulde bestand is dat
# wél. Random waarden maak je met:  openssl rand -hex 32
#
#   cp .env.example .env && chmod 600 .env
#   docker compose up -d

# ── Images: gepind, nooit :latest of :main ────────────────────────────────────
# CHAT_IMAGE heeft geen default: een installatie moet zeggen wélke Ratatoskr
# er draait. BUZZ_REF in chat/Dockerfile hoort bij dezelfde upstream-commit als
# BUZZ_IMAGE — bump je de een, bump dan de ander.
CHAT_IMAGE=ghcr.io/mwest2020/ratatoskr-chat:0.2.0
BUZZ_IMAGE=ghcr.io/block/buzz:sha-4baccd5

# ── Waar is dit bereikbaar ───────────────────────────────────────────────────
# BIND_ADDR is de enige knop die bepaalt wie erbij kan. 127.0.0.1 = alleen deze
# machine; zet een reverse proxy of een VPN ervoor. Wil je 'm bewust op het LAN
# (0.0.0.0), lees dan eerst docs/how-to/installeren.md — dat kost je de
# netwerklaag, en dan is het inloggen je enige control.
BIND_ADDR=127.0.0.1
CHAT_HTTP_PORT=8090

# De relay heeft een eigen knop, want een ander publiek: agents en andere
# machines praten er rechtstreeks mee, terwijl de chat achter een proxy of
# tunnel hoort te blijven. Draaien al je agents op dezelfde machine, laat dit
# dan op 127.0.0.1 staan.
RELAY_BIND_ADDR=127.0.0.1
BUZZ_HTTP_PORT=3000
COMPOSE_PROJECT=ratatoskr

# De URL waarop de chat voor mensen bereikbaar is (https als er TLS voor staat).
# Gebruikt in uitnodigings- en setup-links; fout ingevuld = links die nergens
# heen gaan.
RATATOSKR_URL=https://ratatoskr.example.org

# ── Relay: identiteit en toegang ─────────────────────────────────────────────
BUZZ_DOMAIN=ratatoskr.example.org
RELAY_URL=ws://relay:3000

# Waar de CHAT de relay aanspreekt. Verse installatie: laat dit leeg, dan gebruikt
# hij `ws://relay:3000` over het interne netwerk. Zet je de chat vóór een relay die
# al bestond, vul dan de host in waarop díe community geconfigureerd staat — anders
# antwoordt de relay met "404: no community is configured for this host" en laadt
# de app niets (gemeten op Marks installatie, 2026-09-11).
BUZZ_RELAY_URL=
# Moet op /media eindigen — de relay weigert te starten als dat niet zo is
# (gemeten op een verse installatie: "public_base_url must end with /media").
# Dit is de url waarop een BROWSER media ophaalt, dus je publieke adres.
BUZZ_MEDIA_BASE_URL=https://ratatoskr.example.org/media
BUZZ_MEDIA_SERVER_DOMAIN=ratatoskr.example.org
BUZZ_CORS_ORIGINS=https://ratatoskr.example.org

# Gesloten relay: alleen leden, owner-pubkey verplicht. Niet versoepelen zonder
# te weten wat je weggeeft — dit is de identiteitslaag onder het inloggen.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=false
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=info

# Nostr-pubkey (64 hex) van de eigenaar van de relay.
RELAY_OWNER_PUBKEY=

# ── Stabiele secrets: één keer genereren, veilig backuppen ───────────────────
# Verlies van BUZZ_RELAY_PRIVATE_KEY = de relay verliest zijn identiteit.
BUZZ_RELAY_PRIVATE_KEY=
BUZZ_GIT_HOOK_HMAC_SECRET=
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path

# ── De chat ──────────────────────────────────────────────────────────────────
# Nostr-privésleutel (nsec) waarmee de chat namens de mens post, en die van de
# orchestrator voor beheeracties. Beide horen bij identiteiten in de registry.
BUZZ_PRIVATE_KEY=
BUZZ_ORCHESTRATOR_KEY=

# Web Push (optioneel): publieke VAPID-sleutel. Leeg = geen pushmeldingen.
VAPID_PUBLIC=

# GitHub-leeslaag (optioneel): token voor de repo-/PR-weergave in de app.
# Alleen leesrechten; leeg = die knop toont niets.
GITHUB_TOKEN=

# Toegangslog (optioneel): 1 zet per-aanroep-logging aan. Standaard uit.
RATATOSKR_ACCESSLOG=
